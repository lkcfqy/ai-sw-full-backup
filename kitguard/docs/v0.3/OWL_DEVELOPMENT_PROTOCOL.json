{
  "schema_version": 1,
  "name": "KitGuard OWLv2 target-blind CPU development probe v1",
  "created_at_utc": "2026-09-26T11:58:50.726985+00:00",
  "status": "fixed_before_first_OWLv2_inference",
  "model": {
    "repo_id": "google/owlv2-base-patch16-ensemble",
    "revision": "cfd3195ba4ea9592eec887ded089f4c08eff231d",
    "safetensors_sha256": "e1e130b9e404cf91a75ad45644c1da9d7fa5284085eecc864266a6923efb99e7",
    "device": "cpu",
    "dtype": "float32",
    "torch_threads": 4,
    "interop_threads": 1
  },
  "queries": [
    {
      "part": "bolt",
      "text": "a photo of a metal screw or bolt"
    },
    {
      "part": "nut",
      "text": "a photo of a metal hex nut"
    },
    {
      "part": "washer",
      "text": "a photo of a metal washer"
    },
    {
      "part": "bracket",
      "text": "a photo of an L-shaped metal bracket"
    }
  ],
  "postprocess": {
    "score_threshold": 0.1,
    "threshold_comparison": ">",
    "class_rule": "one highest-logit query per raw predicted box; first query index wins exact tie",
    "nms_iou_threshold": 0.5,
    "nms_rule": "same-class greedy descending score; raw box index breaks ties; suppress if IoU > threshold; no cross-class suppression",
    "boxes": "official processor scales to input JPEG pixel coordinates, then clips to image; zero-area boxes rejected and recorded",
    "count_rule": "Count post-NMS boxes per class; no clamp, target fitting, or correction; zero detections is detector zero, not verified absence"
  },
  "input_pipeline": "Reuse SHA-verified JPEGs from actual app-upload runs; no new image selection or Qwen-output conditioning; OWLv2 pinned processor performs its own default transform",
  "raw_recording": "Save raw model logits/pred_boxes/objectness NPZ, thresholded pre-NMS and post-NMS boxes, input JPEG SHA, actual pixel_values tensor SHA/dtype/shape, per-case end-to-end CPU latency",
  "localization": {
    "loco": "No instance-box truth; no mAP or localization accuracy claim",
    "screws": "Fixed IoU >=0.5, same-class greedy prediction-score order, one-to-one matching against AABBs enclosing original author oriented boxes after exact crop translation; report TP/FP/FN and precision/recall, not mAP"
  },
  "evaluation": {
    "count_metrics": [
      "four-class exact count per image / all planned cases",
      "per-class exact count / all planned cases",
      "per-class absolute error on successful inference only plus success denominator",
      "inference/parse errors retained in planned denominator"
    ],
    "usage": "heterogeneous shadow diagnosis only, no ready decisions, no automatic count corrections",
    "single_case_over_60_seconds": "Save completed row then pause before next case; parent notified; resume requires explicit --resume-slow flag"
  },
  "limitations": [
    "Development only; thresholds not selected on model outcomes in this run. Later changes require new protocol/version.",
    "All four queries fixed for every photograph; no BOM, target counts, first-model list or ground-truth input to detector.",
    "Same-class NMS can merge adjacent instances and cross-class duplicate boxes may remain.",
    "Detector scores are not calibrated reliability probabilities. Agreement with Qwen is not independent truth.",
    "No bracket-positive data here; Screws has no washer-positive data.",
    "LOCO constant-normal composition and acquisition domains limit external validity."
  ],
